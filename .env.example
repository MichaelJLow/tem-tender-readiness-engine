# Copy to .env for local development. Never put real credentials in this file.
PORT=3000
HOST=127.0.0.1
TENDER_STATE_PATH=./data/tender-state.json
TENDER_API_URL=http://127.0.0.1:3000
EVALS_DIR=./evals
# Optional Studio URL shown as drill-down on the Console Performance page.
# MASTRA_STUDIO_URL=http://localhost:4113
# Demo operator label recorded on loopback review events. Not authentication.
# REVIEW_ACTOR=local-demo-operator
# Optional absolute directory for Mastra Studio datasets and observability storage.
# Set this to the same path when starting Studio and running evals from another directory.
# MASTRA_DATA_DIR=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
MODEL_MAX_OUTPUT_TOKENS=8192
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
# Optional provider-neutral overrides (take precedence over provider-specific values).
MODEL_API_KEY=
MODEL_API_BASE_URL=
MODEL_ID=
